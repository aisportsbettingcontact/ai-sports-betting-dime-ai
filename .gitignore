tmp/
temp/

# Database
*.db
*.sqlite
*.sqlite3

# Webdev artifacts (checkpoint zips, migrations, etc.)
.webdev/
.project-config.json

# Python bytecode
__pycache__/
*.pyc

# Ad-hoc workflow export; canonical workflows live in .github/workflows/
/github-workflows.zip

# Isolated agent workspaces (superpowers:using-git-worktrees)
.worktrees/
.claude/worktrees/
.superpowers/

# Claude skills symlinks (local tooling, not for deployment)
.claude/skills/*
# pi-harness is real repo content (execution-routing skill), not a symlink
!.claude/skills/pi-harness/
# design-federation is real repo content (UI orchestrator skill), not a symlink
!.claude/skills/design-federation/
# engineering-federation is real repo content (backend/infra orchestrator skill), not a symlink
!.claude/skills/engineering-federation/
# impeccable is vendored real repo content (pinned in its VENDOR.md), not a symlink
!.claude/skills/impeccable/
# emil skills are tracked vendored content (MIT — upstream LICENSE must ship with them)
!.claude/skills/emil-design-eng/
!.claude/skills/apple-design/
!.claude/skills/animation-vocabulary/
!.claude/skills/review-animations/

# Audit notes, DB dumps, and run artifacts (non-sensitive but bulky)
audit-notes/

# Dev-runtime scrape/audit logs — never track
.scraper-logs/

# SEC-INC-001: secret-bearing debug/audit artifacts — local only, never track
database_audit.txt
debug_rg_today-hitters.html
debug_rg_today-pitchers.html
schema_alignment_findings.md


# Machine-specific Claude Code preferences (skill overrides etc.) — never share
.claude/settings.local.json

# Release-gate artifacts (generated)
vitest-results.json
env-gate-report.json
bundle-budget-report.json
perf-results.json
perf-baseline-candidate.json

# Security-audit gate artifacts (generated by osv-scanner)
osv-report.json

# Playwright CLI session artifacts (canonical matrix archive lives in docs/audits/)
.playwright-cli/

# Playwright Test (@playwright/test) run artifacts — e2e/, playwright.config.ts
test-results/
playwright-report/
blob-report/

# pi coding agent (.pi/ project config is committed; local package installs and
# session-sharing workspace are not)
.pi/npm/
.pi/git/
.pi/hf-sessions/

# Audit screenshot evidence stays out of git (removed 2026-08-05 to cut clone
# size; reports + JSON sidecars remain tracked — regenerated PNGs must not
# be re-committed).
audits/**/*.png
# Same policy for design-federation evidence bundles (docs/audits/*-evidence/):
# screenshots live on disk / in the PR body, never in git.
docs/audits/*-evidence/screenshots/

# Personal reference material (CLAUDE.md: never redistribute) — untracked 2026-08-05
dime-ai/design-bundle/project/uploads/
dime-ai/design-bundle/**/uploads/

# Manus-era session logs: purged from history 2026-08-05 (owner-authorized);
# must never re-enter the repo.
.manus-logs/

# Derived claude.ai upload bundles — regenerate by zipping the corresponding
# skill directory (.claude/skills/<name>/ or .agents/skills/<name>/); never track.
.claude/skill-zips/
