{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aisportsbettingmodels.com/schemas/dime-control-plane-targets.v1.json",
  "title": "Dime control-plane targets v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "cache", "github", "railway", "safety"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "const": "dime-control-plane-targets"
    },
    "cache": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ttlSeconds", "lockMaxAgeSeconds", "lockWaitSeconds"],
      "properties": {
        "ttlSeconds": {
          "type": "integer",
          "minimum": 30,
          "maximum": 3600
        },
        "lockMaxAgeSeconds": {
          "type": "integer",
          "minimum": 10,
          "maximum": 300
        },
        "lockWaitSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        }
      }
    },
    "github": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host", "repository", "defaultBranch", "originUrl"],
      "properties": {
        "host": {
          "const": "github.com"
        },
        "repository": {
          "const": "tailered-ai/dime-ai"
        },
        "defaultBranch": {
          "const": "main"
        },
        "originUrl": {
          "const": "https://github.com/tailered-ai/dime-ai.git"
        }
      }
    },
    "railway": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workspace", "project", "environment", "services"],
      "properties": {
        "workspace": {
          "$ref": "#/$defs/identity"
        },
        "project": {
          "$ref": "#/$defs/identity"
        },
        "environment": {
          "$ref": "#/$defs/identity"
        },
        "services": {
          "type": "object",
          "additionalProperties": false,
          "required": ["application", "backend", "database"],
          "properties": {
            "application": {
              "$ref": "#/$defs/repositoryService"
            },
            "backend": {
              "$ref": "#/$defs/repositoryService"
            },
            "database": {
              "$ref": "#/$defs/databaseService"
            }
          }
        }
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "remoteMutationsAuthorized",
        "mutationCommandsExposed",
        "authorizedOperations"
      ],
      "properties": {
        "mode": {
          "const": "read-only"
        },
        "remoteMutationsAuthorized": {
          "const": false
        },
        "mutationCommandsExposed": {
          "const": false
        },
        "authorizedOperations": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": ["identity", "topology", "deployment-list", "public-health"]
          }
        }
      }
    }
  },
  "$defs": {
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "repositoryService": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "expectedRepository", "healthUrl"],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "expectedRepository": {
          "const": "tailered-ai/dime-ai"
        },
        "healthUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        }
      }
    },
    "databaseService": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "expectedImagePrefix"],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "expectedImagePrefix": {
          "const": "mysql:"
        }
      }
    }
  }
}
