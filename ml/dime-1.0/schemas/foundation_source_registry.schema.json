{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dime.internal/schemas/foundation_source_registry.schema.json",
  "title": "Dime Foundation v1 Source Registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "dataset_version",
    "generated_at_utc",
    "sources"
  ],
  "properties": {
    "schema_version": {
      "const": "dime-foundation-source-registry-v1"
    },
    "dataset_version": {
      "const": "dime-sft-foundation-v1"
    },
    "generated_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/source"
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "source_class",
        "source_owner",
        "snapshot_id",
        "snapshot_sha256",
        "snapshot_file",
        "snapshot_at_utc",
        "available_at_utc",
        "rights_record_id",
        "ml_training_permitted",
        "derivative_use_permitted",
        "public_redistribution_permitted",
        "contains_user_data",
        "contains_provider_derived_data",
        "restrictions",
        "expires_at_utc",
        "reviewer_ids",
        "reviewed_at_utc"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "source_class": {
          "enum": [
            "human-authored",
            "synthetic",
            "teacher-generated",
            "provider-derived",
            "user-derived"
          ]
        },
        "source_owner": {
          "type": "string",
          "minLength": 1
        },
        "snapshot_id": {
          "type": "string",
          "minLength": 1
        },
        "snapshot_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "snapshot_file": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
        },
        "snapshot_at_utc": {
          "type": "string",
          "format": "date-time"
        },
        "available_at_utc": {
          "type": "string",
          "format": "date-time"
        },
        "rights_record_id": {
          "type": "string",
          "minLength": 1
        },
        "ml_training_permitted": {
          "const": true
        },
        "derivative_use_permitted": {
          "const": true
        },
        "public_redistribution_permitted": {
          "type": "boolean"
        },
        "contains_user_data": {
          "type": "boolean"
        },
        "contains_provider_derived_data": {
          "type": "boolean"
        },
        "restrictions": {
          "type": "string",
          "minLength": 1
        },
        "expires_at_utc": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "reviewer_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "agent_decision_receipts": {
          "type": "object",
          "description": "Exact reviewer_id-to-receipt-digest map for every AI-agent rights reviewer and no human reviewers.",
          "propertyNames": {
            "type": "string",
            "minLength": 1
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "reviewed_at_utc": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
