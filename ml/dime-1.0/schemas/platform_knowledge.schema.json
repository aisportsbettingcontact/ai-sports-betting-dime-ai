{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dime.local/schemas/platform_knowledge.schema.json",
  "title": "Dime Platform Knowledge",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "knowledge_version",
    "status",
    "as_of_utc",
    "scope",
    "features",
    "global_rules"
  ],
  "properties": {
    "schema_version": {
      "const": "dime-platform-knowledge-v1"
    },
    "knowledge_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "status": {
      "const": "active"
    },
    "as_of_utc": {
      "type": "string",
      "format": "date-time"
    },
    "scope": {
      "const": "public_product_capabilities"
    },
    "features": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "route",
          "availability",
          "access_scope",
          "description",
          "provides",
          "limitations",
          "evidence_paths"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "route": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^/\\S+$"
              },
              {
                "type": "null"
              }
            ]
          },
          "availability": {
            "enum": ["live", "not_available"]
          },
          "access_scope": {
            "enum": ["public", "authenticated", "owner", "none"]
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "provides": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "limitations": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "evidence_paths": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^(client|server|drizzle|ml)/"
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "availability": {
                  "const": "live"
                }
              }
            },
            "then": {
              "properties": {
                "route": {
                  "type": "string",
                  "pattern": "^/\\S+$"
                },
                "access_scope": {
                  "enum": ["public", "authenticated", "owner"]
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "availability": {
                  "const": "not_available"
                }
              }
            },
            "then": {
              "properties": {
                "route": {
                  "type": "null"
                },
                "access_scope": {
                  "const": "none"
                }
              }
            }
          }
        ]
      }
    },
    "global_rules": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
