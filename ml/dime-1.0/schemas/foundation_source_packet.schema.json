{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dime.internal/schemas/foundation_source_packet.schema.json",
  "title": "Dime Foundation Source Packet",
  "type": "object",
  "additionalProperties": false,
  "required": ["packet_id", "source_class", "source_locator", "snapshot_timestamp", "snapshot_sha256", "rights_status", "allowed_uses", "prohibited_uses"],
  "properties": {
    "packet_id": {"type": "string", "pattern": "^packet-[a-z0-9][a-z0-9._-]{5,95}$"},
    "source_class": {
      "enum": [
        "platform_documentation",
        "product_and_account_contracts",
        "tool_schemas",
        "routing_policies",
        "timestamped_historical_sports_records",
        "deterministic_market_math",
        "failure_catalogs",
        "behavioral_principles"
      ]
    },
    "source_locator": {"type": "string", "minLength": 1, "maxLength": 512},
    "snapshot_timestamp": {"type": "string", "format": "date-time"},
    "snapshot_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "rights_status": {"enum": ["approved_internal", "licensed", "public_domain", "synthetic_behavioral", "pending"]},
    "allowed_uses": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "prohibited_uses": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  }
}
