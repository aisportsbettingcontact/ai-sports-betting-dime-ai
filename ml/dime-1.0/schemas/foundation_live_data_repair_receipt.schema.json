{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dime.internal/schemas/foundation_live_data_repair_receipt.schema.json",
  "title": "Dime Foundation Live Data Repair Receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_id",
    "source_execution_id",
    "original_draft_sha256",
    "original_decision_sha256",
    "finding_closures",
    "actor_id",
    "model_id",
    "model_revision",
    "prompt_revision",
    "prompt_sha256",
    "context_sha256",
    "responsibility",
    "generated_at"
  ],
  "properties": {
    "schema_version": {
      "const": "dime-foundation-live-data-repair-receipt-v1"
    },
    "record_id": {
      "type": "string",
      "pattern": "^dime-foundation-v1-live-data-(?:0(?:1[1-9]|[2-9][0-9])|1(?:0[0-9]|10))-[a-z0-9_]+$"
    },
    "source_execution_id": {
      "const": "foundation-live-data-shard-001-b9ba7788"
    },
    "original_draft_sha256": {"$ref": "#/$defs/sha256"},
    "original_decision_sha256": {"$ref": "#/$defs/sha256"},
    "finding_closures": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["finding_id", "resolution"],
        "properties": {
          "finding_id": {
            "type": "string",
            "pattern": "^live-data-(?:0(?:1[1-9]|[2-9][0-9])|1(?:0[0-9]|10))-(?:ungrounded-tool-arguments|stale-window-claim-unsupported)$"
          },
          "resolution": {
            "enum": [
              "model_visible_arguments_and_partition_event_binding",
              "prose_limited_to_explicit_stale_status"
            ]
          }
        }
      }
    },
    "actor_id": {
      "const": "codex-foundation-live-data-repair-generator-001"
    },
    "model_id": {"const": "gpt-5.6-sol"},
    "model_revision": {"const": "gpt-5.6-sol-2026-07-30"},
    "prompt_revision": {
      "const": "foundation-generation-live-data-repair-v1"
    },
    "prompt_sha256": {"$ref": "#/$defs/sha256"},
    "context_sha256": {"$ref": "#/$defs/sha256"},
    "responsibility": {"const": "generation"},
    "generated_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
