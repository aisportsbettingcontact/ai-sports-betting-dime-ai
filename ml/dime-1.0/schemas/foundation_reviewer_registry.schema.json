{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dime.internal/schemas/foundation_reviewer_registry.schema.json",
  "title": "Dime Foundation Trusted Reviewer Registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "registry_version",
    "status",
    "reviewers"
  ],
  "properties": {
    "schema_version": {
      "const": "dime-foundation-reviewer-registry-v1"
    },
    "registry_version": {
      "type": "string",
      "pattern": "^dime-foundation-reviewers-v[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "Immutable semantic version for one exact registry byte revision."
    },
    "status": {
      "enum": [
        "proposed",
        "active",
        "retired"
      ],
      "default": "proposed"
    },
    "reviewers": {
      "type": "array",
      "uniqueItems": true,
      "description": "Reviewer IDs must be unique, stable across versions, and never reassigned.",
      "items": {
        "$ref": "#/$defs/reviewer"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "active"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "reviewers": {
            "type": "array",
            "minItems": 1,
            "contains": {
              "type": "object",
              "properties": {
                "active": {
                  "const": true
                }
              },
              "required": [
                "active"
              ]
            },
            "minContains": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "proposed",
              "retired"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "reviewers": {
            "type": "array",
            "not": {
              "contains": {
                "type": "object",
                "properties": {
                  "active": {
                    "const": true
                  }
                },
                "required": [
                  "active"
                ]
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewer_id",
        "active",
        "roles"
      ],
      "properties": {
        "reviewer_id": {
          "type": "string",
          "pattern": "^dime-reviewer-[a-z0-9][a-z0-9._-]{7,63}$",
          "description": "Stable opaque authority ID; never a name, email address, or reusable placeholder.",
          "not": {
            "pattern": "(?:replace|placeholder|example|sample|test|tbd|todo|unknown|anonymous|reviewer[-_.]?[ab])"
          }
        },
        "active": {
          "type": "boolean"
        },
        "roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "domain",
              "numeric",
              "coaching",
              "simulation",
              "safety",
              "privacy",
              "rights",
              "semantic-audit",
              "evaluation-audit",
              "locked-evaluation",
              "dataset-approver"
            ]
          }
        }
      }
    }
  }
}
