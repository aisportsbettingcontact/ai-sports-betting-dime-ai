{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dime.internal/schemas/foundation_pilot_repair_report.schema.json",
  "title": "Dime Foundation Pilot Repair Report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "revision_id",
    "created_at",
    "source_commit",
    "source_pilot_execution_id",
    "status",
    "counts",
    "bindings",
    "records",
    "gates",
    "external_operations"
  ],
  "properties": {
    "schema_version": {
      "const": "dime-foundation-pilot-repair-report-v1"
    },
    "revision_id": {
      "const": "foundation-pilot-repair-001"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_commit": {
      "const": "b9ba7788749365253a6f725fee2a2a367a3475dd"
    },
    "source_pilot_execution_id": {
      "const": "foundation-pilot-v1-b9ba7788"
    },
    "status": {
      "const": "READY_FOR_INDEPENDENT_REREVIEW"
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "original_records",
        "approved_records_unchanged",
        "repaired_records",
        "repair_train",
        "repair_validation",
        "critic_findings_addressed"
      ],
      "properties": {
        "original_records": {"const": 20},
        "approved_records_unchanged": {"const": 12},
        "repaired_records": {"const": 8},
        "repair_train": {"const": 7},
        "repair_validation": {"const": 1},
        "critic_findings_addressed": {"const": 10}
      }
    },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "original_pilot_manifest_sha256",
        "blocked_finalization_attempt_sha256",
        "repair_authoring_manifest_sha256",
        "repair_context_manifest_sha256",
        "repair_receipt_manifest_sha256"
      ],
      "properties": {
        "original_pilot_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "blocked_finalization_attempt_sha256": {"$ref": "#/$defs/sha256"},
        "repair_authoring_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "repair_context_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "repair_receipt_manifest_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "records": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "record_id",
          "split",
          "original_draft_sha256",
          "original_decision_sha256",
          "repaired_draft_sha256",
          "generator_context_packet_sha256",
          "critic_context_packet_sha256",
          "generator_receipt_sha256",
          "finding_ids"
        ],
        "properties": {
          "record_id": {
            "type": "string",
            "pattern": "^dime-foundation-v1-pilot-(?:003|011|012|014|015|016|019|020)-[a-z_]+$"
          },
          "split": {
            "enum": ["train", "validation"]
          },
          "original_draft_sha256": {"$ref": "#/$defs/sha256"},
          "original_decision_sha256": {"$ref": "#/$defs/sha256"},
          "repaired_draft_sha256": {"$ref": "#/$defs/sha256"},
          "generator_context_packet_sha256": {"$ref": "#/$defs/sha256"},
          "critic_context_packet_sha256": {"$ref": "#/$defs/sha256"},
          "generator_receipt_sha256": {"$ref": "#/$defs/sha256"},
          "finding_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 2,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^pilot-[0-9]{3}-[a-z0-9-]+$"
            }
          }
        }
      }
    },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_failures",
        "provenance_failures",
        "mode_failures",
        "approved_record_mutations",
        "partition_mutations",
        "unaddressed_findings",
        "critic_decisions_written"
      ],
      "properties": {
        "schema_failures": {"const": 0},
        "provenance_failures": {"const": 0},
        "mode_failures": {"const": 0},
        "approved_record_mutations": {"const": 0},
        "partition_mutations": {"const": 0},
        "unaddressed_findings": {"const": 0},
        "critic_decisions_written": {"const": 0}
      }
    },
    "external_operations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "credential_reads",
        "network_calls",
        "provider_invocations",
        "model_downloads",
        "railway_mutations",
        "production_data_reads",
        "training_runs",
        "publications"
      ],
      "properties": {
        "credential_reads": {"const": 0},
        "network_calls": {"const": 0},
        "provider_invocations": {"const": 0},
        "model_downloads": {"const": 0},
        "railway_mutations": {"const": 0},
        "production_data_reads": {"const": 0},
        "training_runs": {"const": 0},
        "publications": {"const": 0}
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
