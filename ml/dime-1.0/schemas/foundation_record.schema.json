{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dime.internal/schemas/foundation_record.schema.json",
  "title": "Dime Foundation v1 Authoring Record",
  "description": "Canonical private Data Factory record. This is an authoring boundary, not the trainer-ready SFT release schema.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_id",
    "route",
    "task_type",
    "conversation",
    "source_type",
    "source_reference",
    "source_timestamp",
    "provenance",
    "rights_status",
    "tool_requirement",
    "tool_schema_revision",
    "freshness_class",
    "expected_behavior",
    "expected_response",
    "critical_constraints",
    "uncertainty_behavior",
    "split"
  ],
  "properties": {
    "record_id": {
      "type": "string",
      "pattern": "^dime-foundation-v1-[a-z0-9][a-z0-9._-]{7,95}$"
    },
    "route": {
      "$ref": "#/$defs/route"
    },
    "task_type": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"
    },
    "conversation": {
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "#/$defs/message"
      }
    },
    "source_type": {
      "enum": [
        "source_packet",
        "synthetic_behavioral"
      ]
    },
    "source_reference": {
      "oneOf": [
        {
          "$ref": "#/$defs/source_packet_reference"
        },
        {
          "type": "null"
        }
      ]
    },
    "source_timestamp": {
      "oneOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "rights_status": {
      "enum": [
        "approved_internal",
        "licensed",
        "public_domain",
        "synthetic_behavioral",
        "pending"
      ]
    },
    "tool_requirement": {
      "enum": [
        "required",
        "optional",
        "prohibited"
      ]
    },
    "tool_schema_revision": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{2,95}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "freshness_class": {
      "enum": [
        "static",
        "historical_as_of",
        "temporal",
        "live"
      ]
    },
    "expected_behavior": {
      "$ref": "#/$defs/expected_behavior"
    },
    "expected_response": {
      "type": "string",
      "minLength": 1,
      "maxLength": 12000
    },
    "critical_constraints": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 3,
        "maxLength": 240
      }
    },
    "uncertainty_behavior": {
      "enum": [
        "state_material_uncertainty",
        "clarify",
        "abstain",
        "correct_false_premise",
        "not_applicable"
      ]
    },
    "split": {
      "enum": [
        "train",
        "validation"
      ]
    }
  },
  "$defs": {
    "route": {
      "enum": [
        "platform",
        "account",
        "educational",
        "bet_explanation",
        "matchup",
        "full_slate",
        "historical",
        "live_data",
        "general_sports"
      ]
    },
    "message": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "content"
      ],
      "properties": {
        "role": {
          "enum": [
            "user",
            "assistant",
            "tool"
          ]
        },
        "content": {
          "type": "string",
          "maxLength": 12000
        },
        "tool_name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{2,63}$"
        },
        "tool_payload": {
          "type": "object"
        }
      }
    },
    "source_packet_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packet_id",
        "snapshot_sha256",
        "locator"
      ],
      "properties": {
        "packet_id": {
          "type": "string",
          "pattern": "^packet-[a-z0-9][a-z0-9._-]{5,95}$"
        },
        "snapshot_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "locator": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      }
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actor_id",
        "model_id",
        "model_revision"
      ],
      "properties": {
        "actor_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{2,95}$"
        },
        "model_id": {
          "const": "gpt-5.6-sol"
        },
        "model_revision": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shard_id",
        "created_at",
        "generator",
        "critic",
        "generation_receipt_sha256",
        "critique_receipt_sha256"
      ],
      "properties": {
        "shard_id": {
          "type": "string",
          "pattern": "^foundation-v1-[a-z0-9][a-z0-9._-]{3,95}$"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "generator": {
          "$ref": "#/$defs/actor"
        },
        "critic": {
          "$ref": "#/$defs/actor"
        },
        "generation_receipt_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "critique_receipt_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "expected_behavior": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary",
        "coverage"
      ],
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 3,
          "maxLength": 1000
        },
        "coverage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tool_required",
            "temporal_or_freshness_sensitive",
            "missing_or_ambiguous_information",
            "abstention_or_error_correction",
            "multi_turn",
            "adversarial_or_false_premise"
          ],
          "properties": {
            "tool_required": {
              "type": "boolean"
            },
            "temporal_or_freshness_sensitive": {
              "type": "boolean"
            },
            "missing_or_ambiguous_information": {
              "type": "boolean"
            },
            "abstention_or_error_correction": {
              "type": "boolean"
            },
            "multi_turn": {
              "type": "boolean"
            },
            "adversarial_or_false_premise": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "source_type": {
            "const": "source_packet"
          }
        }
      },
      "then": {
        "properties": {
          "source_reference": {
            "$ref": "#/$defs/source_packet_reference"
          },
          "rights_status": {
            "enum": [
              "approved_internal",
              "licensed",
              "public_domain",
              "pending"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "source_type": {
            "const": "synthetic_behavioral"
          }
        }
      },
      "then": {
        "properties": {
          "source_reference": {
            "type": "null"
          },
          "rights_status": {
            "const": "synthetic_behavioral"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "tool_requirement": {
            "const": "required"
          }
        }
      },
      "then": {
        "properties": {
          "tool_schema_revision": {
            "type": "string"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "freshness_class": {
            "enum": [
              "historical_as_of",
              "temporal",
              "live"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "source_timestamp": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  ]
}
