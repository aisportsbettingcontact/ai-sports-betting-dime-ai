{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dime.internal/schemas/evaluation_answer_key_governance.schema.json",
  "title": "Dime Evaluation Answer-Key and Scorer Isolation Governance v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "governance_id",
    "status",
    "source_commit",
    "authorization_effect",
    "semantic_layers",
    "artifact_contracts",
    "resource_universe",
    "identities",
    "answer_key_lifecycle",
    "blinding",
    "locked_control",
    "owner_merge_authorization_scope",
    "still_not_authorized"
  ],
  "properties": {
    "schema_version": {
      "const": "dime-evaluation-answer-key-governance-v1"
    },
    "governance_id": {
      "const": "dime-llm-v1-answer-key-and-scorer-isolation"
    },
    "status": {
      "const": "PROPOSED_NON_EXECUTING"
    },
    "source_commit": {
      "const": "7ed09adb4fcdb9e2d9047e73e34f84c80d865b78"
    },
    "authorization_effect": {
      "const": "NONE_UNTIL_OWNER_MERGE_OF_EXACT_REVIEWED_HEAD"
    },
    "semantic_layers": {
      "const": {
        "development": {
          "case_count": 270,
          "semantic_repo_id": "taileredsports/dime-eval-development-cases",
          "answer_key_repo_id": "taileredsports/dime-eval-development-keys"
        },
        "critical": {
          "case_count": 81,
          "semantic_repo_id": "taileredsports/dime-eval-critical-cases",
          "answer_key_repo_id": "taileredsports/dime-eval-critical-keys"
        },
        "locked": {
          "case_count": 180,
          "semantic_repo_id": "taileredsports/dime-eval-locked-cases",
          "answer_key_repo_id": "taileredsports/dime-eval-locked-keys"
        },
        "general_regression": {
          "case_count": 120,
          "semantic_repo_id": "taileredsports/dime-eval-general-regression-cases",
          "answer_key_repo_id": "taileredsports/dime-eval-general-regression-keys"
        }
      }
    },
    "artifact_contracts": {
      "const": {
        "answer_key_record_schema": "ml/dime-1.0/schemas/evaluation_answer_key_record.schema.json",
        "blinded_output_schema": "ml/dime-1.0/schemas/evaluation_blinded_output.schema.json",
        "locked_consumption_ledger_schema": "ml/dime-1.0/schemas/evaluation_locked_consumption_ledger.schema.json",
        "governance_validator": "ml/dime-1.0/src/dime_ai/evaluation_answer_key_governance.py",
        "static_audit": "ml/dime-1.0/scripts/validate_evaluation_answer_key_governance.py"
      }
    },
    "resource_universe": {
      "const": [
        "private_foundation",
        "evaluation_semantic_cases",
        "evaluation_semantic_manifests",
        "evaluation_answer_keys",
        "evaluation_answer_key_manifests",
        "blinded_model_outputs",
        "evaluation_scores",
        "locked_consumption_ledger",
        "model_endpoint"
      ]
    },
    "identities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "training",
        "model_runner",
        "scorer",
        "locked_controller"
      ],
      "properties": {
        "training": {
          "$ref": "#/$defs/identity"
        },
        "model_runner": {
          "$ref": "#/$defs/identity"
        },
        "scorer": {
          "$ref": "#/$defs/identity"
        },
        "locked_controller": {
          "$ref": "#/$defs/identity"
        }
      }
    },
    "answer_key_lifecycle": {
      "const": {
        "generation_mode": "offline_private_governed_authorship",
        "persistent_runtime_generator_identity": false,
        "semantic_record_sha256_binding_required": true,
        "semantic_case_content_copy_prohibited": true,
        "private_repository_required": true,
        "semantic_and_key_repository_separation_required": true,
        "record_checksum_manifest_required": true,
        "provenance_receipt_required": true,
        "independent_review_required": true,
        "secret_scan_required": true,
        "publication_credentials_provisioned": false,
        "publication_preconditions": [
          "exact_semantic_revision",
          "exact_semantic_manifest_sha256",
          "record_level_semantic_sha256_bindings",
          "answer_key_record_schema_pass",
          "independent_review_pass",
          "record_checksum_manifest_pass",
          "private_repository_access_policy_pass",
          "secret_scan_pass"
        ]
      }
    },
    "blinding": {
      "const": {
        "candidate_provider_identity_in_output": false,
        "candidate_model_identity_in_output": false,
        "semantic_case_content_in_output": false,
        "answer_key_material_in_output": false,
        "blind_id_required": true,
        "semantic_record_sha256_required": true,
        "output_receipt_sha256_required": true
      }
    },
    "locked_control": {
      "const": {
        "maximum_authorized_executions_per_revision": 1,
        "current_authorized_executions": 0,
        "execution_authorized": false,
        "separate_benchmark_execution_gate_required": true,
        "attempt_consumes_allowance": true,
        "retry_after_consumption_allowed": false,
        "append_only_ledger_required": true,
        "consumption_receipt_required": true,
        "unconsumed_exact_revision_required": true
      }
    },
    "owner_merge_authorization_scope": {
      "const": {
        "private_answer_key_generation": true,
        "private_answer_key_publication": true,
        "training_runner_scorer_separation": true,
        "locked_consumption_ledger": true
      }
    },
    "still_not_authorized": {
      "const": {
        "model_download": false,
        "runpod_inference": false,
        "benchmark_execution": false,
        "model_training": false,
        "model_serving": false,
        "railway_mutation": false
      }
    }
  },
  "$defs": {
    "resource": {
      "enum": [
        "private_foundation",
        "evaluation_semantic_cases",
        "evaluation_semantic_manifests",
        "evaluation_answer_keys",
        "evaluation_answer_key_manifests",
        "blinded_model_outputs",
        "evaluation_scores",
        "locked_consumption_ledger",
        "model_endpoint"
      ]
    },
    "resource_list": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/resource"
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity_id",
        "responsibility",
        "allowed_read",
        "allowed_write",
        "denied_read",
        "denied_write",
        "allowed_actions_after_owner_merge",
        "credential_provisioned",
        "model_endpoint_access"
      ],
      "properties": {
        "identity_id": {
          "type": "string",
          "pattern": "^dime-[a-z0-9][a-z0-9-]{7,95}-v1$"
        },
        "responsibility": {
          "enum": [
            "foundation_training_only",
            "semantic_case_inference_and_blinded_output_only",
            "answer_key_and_blinded_output_scoring_only",
            "single_use_authorization_and_consumption_ledger_only"
          ]
        },
        "allowed_read": {
          "$ref": "#/$defs/resource_list"
        },
        "allowed_write": {
          "$ref": "#/$defs/resource_list"
        },
        "denied_read": {
          "$ref": "#/$defs/resource_list"
        },
        "denied_write": {
          "$ref": "#/$defs/resource_list"
        },
        "allowed_actions_after_owner_merge": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "use_private_foundation_control_plane",
              "read_semantic_cases",
              "write_blinded_outputs",
              "read_answer_keys",
              "read_blinded_outputs",
              "write_evaluation_scores",
              "enforce_single_use_locked_lease",
              "append_locked_consumption_receipt"
            ]
          }
        },
        "credential_provisioned": {
          "const": false
        },
        "model_endpoint_access": {
          "enum": [
            "denied",
            "separate_benchmark_gate_required"
          ]
        }
      }
    }
  }
}
