{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dime.internal/schemas/evaluation_identity_plan.schema.json",
  "title": "Dime Evaluation Identity Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_id",
    "status",
    "source_commit",
    "layers",
    "legacy_exposed_critical",
    "required_identity_controls",
    "access_separation",
    "non_overlap_proof",
    "known_blockers",
    "authorization_boundary"
  ],
  "properties": {
    "schema_version": {
      "const": "dime-evaluation-identity-plan-v1"
    },
    "plan_id": {
      "const": "dime-llm-v1-evaluation-identities"
    },
    "status": {
      "const": "INCOMPLETE_NOT_AUTHORIZED"
    },
    "source_commit": {
      "const": "77caa613ad2c64ff91a5c6fab1839b3d1278f4ba"
    },
    "layers": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "development",
        "critical",
        "locked",
        "general_regression"
      ],
      "properties": {
        "development": {
          "$ref": "#/$defs/development_layer"
        },
        "critical": {
          "$ref": "#/$defs/critical_layer"
        },
        "locked": {
          "$ref": "#/$defs/locked_layer"
        },
        "general_regression": {
          "$ref": "#/$defs/general_regression_layer"
        }
      }
    },
    "legacy_exposed_critical": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "case_count",
        "status",
        "allowed_use"
      ],
      "properties": {
        "path": {
          "const": "ml/dime-1.0/evidence/benchmarks/model-artifact-evaluation-v1/contract.json"
        },
        "sha256": {
          "const": "5df817d1ac003cf6485b53c01bbfb03b1be4cb05fde4ea06219fac4a9ba27c19"
        },
        "case_count": {
          "const": 81
        },
        "status": {
          "const": "EXPOSED_NOT_SELECTION_ELIGIBLE"
        },
        "allowed_use": {
          "const": "development_and_architecture_regression_only"
        }
      }
    },
    "required_identity_controls": {
      "const": [
        "immutable_repository_revision",
        "manifest_checksum",
        "record_checksum_manifest",
        "creation_provenance",
        "explicit_non_overlap_proof",
        "training_access_prohibition",
        "separate_answer_key_access"
      ]
    },
    "access_separation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "semantic_cases_exclude_gold_answers",
        "answer_keys_bind_semantic_record_sha256",
        "training_denied_all_evaluation_repositories",
        "runner_denied_answer_keys",
        "scorer_denied_training_data_and_model_execution",
        "locked_maximum_execution_count",
        "locked_consumption_ledger_required",
        "current_status"
      ],
      "properties": {
        "semantic_cases_exclude_gold_answers": {
          "const": true
        },
        "answer_keys_bind_semantic_record_sha256": {
          "const": true
        },
        "training_denied_all_evaluation_repositories": {
          "const": false
        },
        "runner_denied_answer_keys": {
          "const": false
        },
        "scorer_denied_training_data_and_model_execution": {
          "const": false
        },
        "locked_maximum_execution_count": {
          "const": 1
        },
        "locked_consumption_ledger_required": {
          "const": true
        },
        "current_status": {
          "const": "BLOCKED"
        }
      }
    },
    "non_overlap_proof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_pairwise_suite_comparisons",
        "foundation_against_each_suite_comparisons",
        "checks",
        "restricted_report_sha256",
        "public_proof_sha256",
        "status"
      ],
      "properties": {
        "required_pairwise_suite_comparisons": {
          "const": 6
        },
        "foundation_against_each_suite_comparisons": {
          "const": 4
        },
        "checks": {
          "const": [
            "case_ids",
            "exact_record_hashes",
            "normalized_instructions",
            "contexts_and_tool_fixtures",
            "restricted_expected_answers",
            "source_event_user_conversation_and_scenario_partitions",
            "temporal_embargoes"
          ]
        },
        "restricted_report_sha256": {
          "type": "null"
        },
        "public_proof_sha256": {
          "type": "null"
        },
        "status": {
          "const": "MISSING"
        }
      }
    },
    "known_blockers": {
      "const": [
        "The current 81-case suite is exposed in the public application repository with gold behavior and is not selection-eligible.",
        "The training credential can currently read development evaluation data.",
        "No immutable identity exists for the 270-case development evaluation.",
        "No immutable identity exists for the sealed replacement 81-case critical suite.",
        "No immutable identity exists for the 180-case locked evaluation.",
        "No immutable identity exists for the 120-case general-regression evaluation.",
        "No complete pairwise and Foundation non-overlap proof exists.",
        "Model-runner and isolated-scorer credential separation is not implemented."
      ]
    },
    "authorization_boundary": {
      "$ref": "#/$defs/authorization_boundary"
    }
  },
  "$defs": {
    "missing_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repo_id",
        "revision",
        "manifest_sha256",
        "record_checksums_sha256",
        "provenance_sha256"
      ],
      "properties": {
        "repo_id": {
          "type": "string",
          "pattern": "^taileredsports/[a-z0-9][a-z0-9-]{2,95}$"
        },
        "revision": {
          "type": "null"
        },
        "manifest_sha256": {
          "type": "null"
        },
        "record_checksums_sha256": {
          "type": "null"
        },
        "provenance_sha256": {
          "type": "null"
        }
      }
    },
    "layer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "purpose",
        "case_count",
        "route_distribution",
        "semantic_identity",
        "answer_key_identity",
        "required_training_access",
        "effective_access_verified",
        "status"
      ],
      "properties": {
        "purpose": {
          "type": "string"
        },
        "case_count": {
          "type": "integer",
          "minimum": 1
        },
        "route_distribution": {},
        "semantic_identity": {
          "$ref": "#/$defs/missing_identity"
        },
        "answer_key_identity": {
          "$ref": "#/$defs/missing_identity"
        },
        "required_training_access": {
          "const": "prohibited"
        },
        "effective_access_verified": {
          "const": false
        },
        "status": {
          "const": "MISSING"
        }
      }
    },
    "development_layer": {
      "allOf": [
        {
          "$ref": "#/$defs/layer"
        },
        {
          "properties": {
            "purpose": {
              "const": "iteration_and_diagnosis"
            },
            "case_count": {
              "const": 270
            },
            "route_distribution": {
              "$ref": "#/$defs/development_routes"
            },
            "semantic_identity": {
              "allOf": [
                {
                  "$ref": "#/$defs/missing_identity"
                },
                {
                  "properties": {
                    "repo_id": {
                      "const": "taileredsports/dime-eval-development-cases"
                    }
                  }
                }
              ]
            },
            "answer_key_identity": {
              "allOf": [
                {
                  "$ref": "#/$defs/missing_identity"
                },
                {
                  "properties": {
                    "repo_id": {
                      "const": "taileredsports/dime-eval-development-keys"
                    }
                  }
                }
              ]
            }
          }
        }
      ]
    },
    "critical_layer": {
      "allOf": [
        {
          "$ref": "#/$defs/layer"
        },
        {
          "properties": {
            "purpose": {
              "const": "hard_failures_and_protected_behaviors"
            },
            "case_count": {
              "const": 81
            },
            "route_distribution": {
              "type": "null"
            },
            "semantic_identity": {
              "allOf": [
                {
                  "$ref": "#/$defs/missing_identity"
                },
                {
                  "properties": {
                    "repo_id": {
                      "const": "taileredsports/dime-eval-critical-cases"
                    }
                  }
                }
              ]
            },
            "answer_key_identity": {
              "allOf": [
                {
                  "$ref": "#/$defs/missing_identity"
                },
                {
                  "properties": {
                    "repo_id": {
                      "const": "taileredsports/dime-eval-critical-keys"
                    }
                  }
                }
              ]
            }
          }
        }
      ]
    },
    "locked_layer": {
      "allOf": [
        {
          "$ref": "#/$defs/layer"
        },
        {
          "properties": {
            "purpose": {
              "const": "single_use_final_model_selection"
            },
            "case_count": {
              "const": 180
            },
            "route_distribution": {
              "$ref": "#/$defs/locked_routes"
            },
            "semantic_identity": {
              "allOf": [
                {
                  "$ref": "#/$defs/missing_identity"
                },
                {
                  "properties": {
                    "repo_id": {
                      "const": "taileredsports/dime-eval-locked-cases"
                    }
                  }
                }
              ]
            },
            "answer_key_identity": {
              "allOf": [
                {
                  "$ref": "#/$defs/missing_identity"
                },
                {
                  "properties": {
                    "repo_id": {
                      "const": "taileredsports/dime-eval-locked-keys"
                    }
                  }
                }
              ]
            }
          }
        }
      ]
    },
    "general_regression_layer": {
      "allOf": [
        {
          "$ref": "#/$defs/layer"
        },
        {
          "properties": {
            "purpose": {
              "const": "detect_specialization_damage"
            },
            "case_count": {
              "const": 120
            },
            "route_distribution": {
              "type": "null"
            },
            "semantic_identity": {
              "allOf": [
                {
                  "$ref": "#/$defs/missing_identity"
                },
                {
                  "properties": {
                    "repo_id": {
                      "const": "taileredsports/dime-eval-general-regression-cases"
                    }
                  }
                }
              ]
            },
            "answer_key_identity": {
              "allOf": [
                {
                  "$ref": "#/$defs/missing_identity"
                },
                {
                  "properties": {
                    "repo_id": {
                      "const": "taileredsports/dime-eval-general-regression-keys"
                    }
                  }
                }
              ]
            }
          }
        }
      ]
    },
    "development_routes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "platform",
        "account",
        "educational",
        "bet_explanation",
        "matchup",
        "full_slate",
        "historical",
        "live_data",
        "general_sports"
      ],
      "properties": {
        "platform": {
          "const": 30
        },
        "account": {
          "const": 30
        },
        "educational": {
          "const": 30
        },
        "bet_explanation": {
          "const": 30
        },
        "matchup": {
          "const": 30
        },
        "full_slate": {
          "const": 30
        },
        "historical": {
          "const": 30
        },
        "live_data": {
          "const": 30
        },
        "general_sports": {
          "const": 30
        }
      }
    },
    "locked_routes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "platform",
        "account",
        "educational",
        "bet_explanation",
        "matchup",
        "full_slate",
        "historical",
        "live_data",
        "general_sports"
      ],
      "properties": {
        "platform": {
          "const": 20
        },
        "account": {
          "const": 20
        },
        "educational": {
          "const": 20
        },
        "bet_explanation": {
          "const": 20
        },
        "matchup": {
          "const": 20
        },
        "full_slate": {
          "const": 20
        },
        "historical": {
          "const": 20
        },
        "live_data": {
          "const": 20
        },
        "general_sports": {
          "const": 20
        }
      }
    },
    "authorization_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evaluation_dataset_publication",
        "answer_key_publication",
        "runpod_invocation",
        "model_download",
        "benchmark_execution",
        "locked_evaluation_execution",
        "model_selection",
        "model_training",
        "provider_activation",
        "railway_mutation",
        "trace_activation",
        "shadow_traffic",
        "route_activation"
      ],
      "properties": {
        "evaluation_dataset_publication": {
          "const": false
        },
        "answer_key_publication": {
          "const": false
        },
        "runpod_invocation": {
          "const": false
        },
        "model_download": {
          "const": false
        },
        "benchmark_execution": {
          "const": false
        },
        "locked_evaluation_execution": {
          "const": false
        },
        "model_selection": {
          "const": false
        },
        "model_training": {
          "const": false
        },
        "provider_activation": {
