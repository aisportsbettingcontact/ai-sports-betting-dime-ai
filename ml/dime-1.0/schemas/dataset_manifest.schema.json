{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Dime Approved Dataset Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "dataset_version",
    "approved",
    "approved_at_utc",
    "reviewer_ids",
    "train_sha256",
    "validation_sha256",
    "curriculum_config_sha256",
    "tool_catalog_sha256",
    "chat_template_sha256",
    "rights_reviewed",
    "consent_reviewed",
    "privacy_reviewed",
    "partition_audit_passed",
    "future_data_audit_passed",
    "semantic_dedup_audit_passed",
    "evaluation_contamination_audit_passed",
    "direct_identifier_scan_version",
    "deletion_policy_id"
  ],
  "properties": {
    "schema_version": {"const": "dime-dataset-manifest-v2"},
    "dataset_version": {"type": "string", "minLength": 1},
    "approved": {"type": "boolean"},
    "approved_at_utc": {"type": "string", "format": "date-time"},
    "reviewer_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "train_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "validation_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "curriculum_config_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "tool_catalog_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "chat_template_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "rights_reviewed": {"type": "boolean"},
    "consent_reviewed": {"type": "boolean"},
    "privacy_reviewed": {"type": "boolean"},
    "partition_audit_passed": {"type": "boolean"},
    "future_data_audit_passed": {"type": "boolean"},
    "semantic_dedup_audit_passed": {"type": "boolean"},
    "evaluation_contamination_audit_passed": {"type": "boolean"},
    "direct_identifier_scan_version": {"type": "string", "minLength": 1},
    "deletion_policy_id": {"type": "string", "minLength": 1},
    "notes": {"type": "string"}
  }
}
