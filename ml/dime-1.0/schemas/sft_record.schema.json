{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dime.local/schemas/sft_record.schema.json",
  "title": "Dime SFT Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "example_id",
    "dataset_version",
    "task_type",
    "messages",
    "metadata",
    "quality"
  ],
  "properties": {
    "example_id": {"type": "string", "minLength": 1},
    "dataset_version": {"type": "string", "minLength": 1},
    "task_type": {"type": "string", "minLength": 1},
    "messages": {
      "type": "array",
      "minItems": 2,
      "items": {"$ref": "#/$defs/message"}
    },
    "tools": {
      "type": "array",
      "items": {"type": "object"}
    },
    "numeric_assertions": {
      "type": "array",
      "description": "One reviewed claim binding for every numeric token in every assistant message. Each source_path must resolve to a numeric leaf in a linked status=ok tool result; calculate_market_math results are also independently recomputed.",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_path",
          "value",
          "unit",
          "comparator",
          "tolerance",
          "assistant_message_index",
          "claim_text",
          "formatted_value"
        ],
        "properties": {
          "source_path": {
            "type": "string",
            "description": "Path in the form tool:<call-id>:data.<numeric-leaf>; literal, user-message, metadata, and failed-tool sources are not admissible.",
            "minLength": 1
          },
          "value": {"type": "number"},
          "unit": {
            "enum": [
              "probability",
              "percentage_points",
              "decimal_odds",
              "american_odds",
              "units",
              "roi",
              "count"
            ]
          },
          "comparator": {"enum": ["exact", "approximate"]},
          "tolerance": {"type": "number", "minimum": 0},
          "assistant_message_index": {"type": "integer", "minimum": 0},
          "claim_text": {"type": "string", "minLength": 1},
          "formatted_value": {"type": "string", "minLength": 1}
        }
      }
    },
    "curriculum": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "skill_ids",
        "difficulty",
        "interaction_mode",
        "scenario_cluster_id",
        "evidence_status",
        "policy_action",
        "risk_tier",
        "answer_length"
      ],
      "properties": {
        "skill_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "difficulty": {
          "enum": ["foundation", "intermediate", "hard", "adversarial"]
        },
        "interaction_mode": {
          "enum": [
            "successful_tool_assisted",
            "degraded_tool_assisted",
            "direct_no_tool",
            "clarification",
            "abstention",
            "protective_response"
          ]
        },
        "scenario_cluster_id": {"type": "string", "minLength": 1},
        "evidence_status": {
          "enum": [
            "complete",
            "partial",
            "stale",
            "conflicting",
            "missing",
            "unauthorized",
            "blocked",
            "error",
            "not_applicable"
          ]
        },
        "policy_action": {
          "enum": [
            "allow",
            "clarify",
            "abstain",
            "partial",
            "privacy_block",
            "age_block",
            "jurisdiction_block",
            "self_exclusion_block",
            "protective_block",
            "acute_distress_block",
            "not_applicable"
          ]
        },
        "risk_tier": {"enum": ["standard", "high", "critical"]},
        "answer_length": {"enum": ["concise", "normal", "detailed"]},
        "control_pair_id": {"type": ["string", "null"], "minLength": 1},
        "market_math_operation": {
          "type": ["string", "null"],
          "enum": [
            "implied_probability",
            "remove_vig",
            "market_hold",
            "expected_value",
            "settled_profit",
            "roi",
            "probability_clv",
            null
          ]
        },
        "safety_subfamily": {
          "type": ["string", "null"],
          "enum": [
            "responsible_gaming",
            "privacy",
            "security",
            "eligibility",
            "acute_distress",
            "not_applicable",
            null
          ]
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "as_of_utc",
        "synthetic_or_deidentified",
        "contains_user_data",
        "source_ids"
      ],
      "properties": {
        "sport": {"type": ["string", "null"], "minLength": 1},
        "league": {"type": ["string", "null"], "minLength": 1},
        "market_type": {"type": ["string", "null"], "minLength": 1},
        "provider_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "as_of_utc": {"type": "string", "format": "date-time"},
        "available_at_utc": {"type": ["string", "null"], "format": "date-time"},
        "synthetic_or_deidentified": {
          "enum": ["synthetic", "deidentified", "none"]
        },
        "contains_user_data": {"type": "boolean"},
        "consent_basis": {"type": ["string", "null"]},
        "source_ids": {
          "type": "array",
          "items": {"type": "string"}
        },
        "event_partition_key": {"type": ["string", "null"]},
        "source_snapshot_partition_key": {"type": ["string", "null"]},
        "conversation_partition_key": {"type": ["string", "null"]},
        "user_partition_hash": {"type": ["string", "null"]},
        "rights_basis": {"type": ["string", "null"]},
        "source_owner": {"type": ["string", "null"]},
        "author_id": {"type": ["string", "null"]},
        "deidentification_method": {"type": ["string", "null"]},
        "generation_method": {"type": ["string", "null"]},
        "teacher_provenance": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "model_id",
                "model_revision",
                "prompt_sha256",
                "generated_at_utc",
                "seed"
              ],
              "properties": {
                "model_id": {"type": "string", "minLength": 1},
                "model_revision": {"type": "string", "minLength": 1},
                "prompt_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "generated_at_utc": {"type": "string", "format": "date-time"},
                "seed": {"type": "integer"}
              }
            }
          ]
        },
        "deletion_policy_id": {"type": ["string", "null"]},
        "direct_identifier_scan_version": {"type": ["string", "null"]}
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["review_status", "rubric_version"],
      "properties": {
        "review_status": {"enum": ["draft", "approved", "rejected"]},
        "reviewer_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string"}
        },
        "reviewed_at_utc": {"type": ["string", "null"], "format": "date-time"},
        "rubric_version": {"type": "string", "minLength": 1}
      }
    }
  },
  "$defs": {
    "message": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "content"],
      "allOf": [
        {
          "if": {
            "properties": {"role": {"const": "tool"}},
            "required": ["role"]
          },
          "then": {"required": ["name", "tool_call_id"]}
        }
      ],
      "properties": {
        "role": {"enum": ["system", "user", "assistant", "tool"]},
        "content": {"type": "string"},
        "name": {"type": "string", "minLength": 1},
        "tool_call_id": {"type": "string", "minLength": 1},
        "tool_calls": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "type", "function"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "type": {"const": "function"},
              "function": {
                "type": "object",
                "additionalProperties": false,
                "required": ["name", "arguments"],
                "properties": {
                  "name": {"type": "string"},
                  "arguments": {"type": "object"}
                }
              }
            }
          }
        }
      }
    }
  }
}
