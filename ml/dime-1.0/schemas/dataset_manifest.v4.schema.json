{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dime.internal/schemas/dataset_manifest.v4.schema.json",
  "title": "Dime Governed Private Foundation Dataset Manifest v4",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "dataset_version",
    "visibility",
    "publication_classification",
    "provenance_source_class",
    "source_owner",
    "rights_basis",
    "license_or_usage_restrictions",
    "synthetic_status",
    "contains_user_data",
    "contains_provider_derived_data",
    "approval_status",
    "approved",
    "approved_at_utc",
    "evidence_valid_until_utc",
    "reviewer_ids",
    "train_record_count",
    "validation_record_count",
    "train_sha256",
    "validation_sha256",
    "curriculum_config_sha256",
    "system_prompt_sha256",
    "tool_catalog_sha256",
    "chat_template_sha256",
    "foundation_build_config_sha256",
    "source_registry_sha256",
    "source_artifacts_sha256",
    "review_ledger_sha256",
    "reviewer_registry_sha256",
    "candidate_audit_sha256",
    "approval_record_sha256",
    "development_eval_repo_id",
    "development_eval_revision",
    "development_eval_manifest_sha256",
    "development_eval_identity_sha256",
    "locked_evaluation_reference",
    "audit_reports",
    "rights_reviewed",
    "consent_reviewed",
    "privacy_reviewed",
    "partition_audit_passed",
    "future_data_audit_passed",
    "exact_dedup_audit_passed",
    "semantic_dedup_audit_passed",
    "evaluation_contamination_audit_passed",
    "numeric_traceability_audit_passed",
    "canonical_system_prompt_enforced",
    "direct_identifier_scan_version",
    "deletion_policy_id",
    "limitations_notes"
  ],
  "properties": {
    "schema_version": {
      "const": "dime-dataset-manifest-v4"
    },
    "dataset_version": {
      "const": "dime-sft-foundation-v1"
    },
    "visibility": {
      "const": "private"
    },
    "publication_classification": {
      "const": "private-only"
    },
    "provenance_source_class": {
      "enum": ["synthetic", "human-authored", "mixed"]
    },
    "source_owner": {
      "type": "string",
      "minLength": 1
    },
    "rights_basis": {
      "type": "string",
      "minLength": 1
    },
    "license_or_usage_restrictions": {
      "type": "string",
      "minLength": 1
    },
    "synthetic_status": {
      "enum": ["fully-synthetic", "mixed"]
    },
    "contains_user_data": {
      "const": false
    },
    "contains_provider_derived_data": {
      "const": false
    },
    "approval_status": {
      "const": "approved"
    },
    "approved": {
      "const": true
    },
    "approved_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "evidence_valid_until_utc": {
      "type": "string",
      "format": "date-time"
    },
    "reviewer_ids": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "train_record_count": {
      "type": "integer",
      "minimum": 1
    },
    "validation_record_count": {
      "type": "integer",
      "minimum": 1
    },
    "train_sha256": {"$ref": "#/$defs/sha256"},
    "validation_sha256": {"$ref": "#/$defs/sha256"},
    "curriculum_config_sha256": {"$ref": "#/$defs/sha256"},
    "system_prompt_sha256": {"$ref": "#/$defs/sha256"},
    "tool_catalog_sha256": {"$ref": "#/$defs/sha256"},
    "chat_template_sha256": {"$ref": "#/$defs/sha256"},
    "foundation_build_config_sha256": {"$ref": "#/$defs/sha256"},
    "source_registry_sha256": {"$ref": "#/$defs/sha256"},
    "source_artifacts_sha256": {"$ref": "#/$defs/sha256"},
    "review_ledger_sha256": {"$ref": "#/$defs/sha256"},
    "reviewer_registry_sha256": {"$ref": "#/$defs/sha256"},
    "candidate_audit_sha256": {"$ref": "#/$defs/sha256"},
    "approval_record_sha256": {"$ref": "#/$defs/sha256"},
    "development_eval_repo_id": {
      "const": "taileredsports/dime-eval-development"
    },
    "development_eval_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "development_eval_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "development_eval_identity_sha256": {"$ref": "#/$defs/sha256"},
    "locked_evaluation_reference": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|locked-eval-(?:approval|suite|revision):[a-z0-9][a-z0-9._-]{3,95})$"
    },
    "audit_reports": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "semantic_deduplication",
        "privacy_and_identifiers",
        "rights",
        "development_evaluation_contamination",
        "locked_evaluation_contamination",
        "numeric_traceability"
      ],
      "properties": {
        "semantic_deduplication": {"$ref": "#/$defs/audit"},
        "privacy_and_identifiers": {"$ref": "#/$defs/audit"},
        "rights": {"$ref": "#/$defs/audit"},
        "development_evaluation_contamination": {"$ref": "#/$defs/audit"},
        "locked_evaluation_contamination": {"$ref": "#/$defs/audit"},
        "numeric_traceability": {"$ref": "#/$defs/audit"}
      }
    },
    "rights_reviewed": {"const": true},
    "consent_reviewed": {"const": true},
    "privacy_reviewed": {"const": true},
    "partition_audit_passed": {"const": true},
    "future_data_audit_passed": {"const": true},
    "exact_dedup_audit_passed": {"const": true},
    "semantic_dedup_audit_passed": {"const": true},
    "evaluation_contamination_audit_passed": {"const": true},
    "numeric_traceability_audit_passed": {"const": true},
    "canonical_system_prompt_enforced": {"const": true},
    "direct_identifier_scan_version": {
      "type": "string",
      "minLength": 1
    },
    "deletion_policy_id": {
      "type": "string",
      "minLength": 1
    },
    "limitations_notes": {
      "type": "string",
      "minLength": 1
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "passed",
        "report_sha256",
        "tool_id",
        "tool_version",
        "completed_at_utc",
        "reviewer_ids"
      ],
      "properties": {
        "passed": {"const": true},
        "report_sha256": {"$ref": "#/$defs/sha256"},
        "tool_id": {"type": "string", "minLength": 1},
        "tool_version": {"type": "string", "minLength": 1},
        "completed_at_utc": {"type": "string", "format": "date-time"},
        "reviewer_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
