{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dime.internal/schemas/foundation_critic_decision.schema.json",
  "title": "Dime Foundation Independent Critic Decision v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "decision_id",
    "record_id",
    "draft_sha256",
    "critic",
    "critic_context_packet_sha256",
    "decision",
    "rubric_version",
    "reviewed_at",
    "findings",
    "unresolved_material_findings",
    "deterministic_validation_passed",
    "decision_receipt_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "dime-foundation-independent-critic-decision-v1"
    },
    "decision_id": {
      "type": "string",
      "pattern": "^foundation-critic-decision-[a-z0-9][a-z0-9._-]{7,127}$"
    },
    "record_id": {
      "type": "string",
      "pattern": "^dime-foundation-v1-[a-z0-9][a-z0-9._-]{7,95}$"
    },
    "draft_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "critic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actor_id",
        "model_id",
        "model_revision",
        "prompt_revision",
        "prompt_sha256",
        "execution_receipt_sha256",
        "context_sha256",
        "responsibility"
      ],
      "properties": {
        "actor_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{2,95}$"
        },
        "model_id": {"const": "gpt-5.6-sol"},
        "model_revision": {"type": "string", "minLength": 3},
        "prompt_revision": {"type": "string", "minLength": 3},
        "prompt_sha256": {"$ref": "#/$defs/sha256"},
        "execution_receipt_sha256": {"$ref": "#/$defs/sha256"},
        "context_sha256": {"$ref": "#/$defs/sha256"},
        "responsibility": {"const": "independent_critique"}
      }
    },
    "critic_context_packet_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "decision": {
      "enum": ["approved", "changes_requested", "rejected"]
    },
    "rubric_version": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,95}$"
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["finding_id", "severity", "summary", "resolved"],
        "properties": {
          "finding_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{2,95}$"
          },
          "severity": {
            "enum": ["low", "medium", "high", "critical"]
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "resolved": {
            "type": "boolean"
          }
        }
      }
    },
    "unresolved_material_findings": {
      "type": "integer",
      "minimum": 0
    },
    "deterministic_validation_passed": {
      "type": "boolean"
    },
    "decision_receipt_sha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
