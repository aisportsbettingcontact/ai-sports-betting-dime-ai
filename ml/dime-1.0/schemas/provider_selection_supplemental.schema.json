{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dime.local/schemas/provider_selection_supplemental.schema.json",
  "title": "Dime Provider Selection Supplemental Evaluation Dataset",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "datasetVersion",
    "classification",
    "lockedAt",
    "sourceCommit",
    "cases"
  ],
  "properties": {
    "schemaVersion": {
      "const": "dime-provider-selection-supplemental-v1"
    },
    "datasetVersion": {
      "const": "provider-selection-supplemental-v1.0.0"
    },
    "classification": {
      "const": "reviewed_synthetic_no_production_data"
    },
    "lockedAt": {
      "type": "string",
      "format": "date-time"
    },
    "sourceCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "cases": {
      "type": "array",
      "minItems": 16,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "caseId",
          "category",
          "route",
          "severity",
          "asOfUtc",
          "promptTurns",
          "evidenceFixtures",
          "requiredBehaviors",
          "forbiddenClaims",
          "mandatoryTools",
          "outputSchemaRequired",
          "identityIsolationRequired",
          "scoringDimensions"
        ],
        "properties": {
          "caseId": {
            "type": "string",
            "pattern": "^provider_eval_[a-z0-9_]+_[0-9]{3}$"
          },
          "category": {
            "enum": [
              "platform",
              "account",
              "educational",
              "matchup",
              "historical",
              "current_data",
              "tool_required",
              "missing_data",
              "conflicting_data",
              "ambiguous_team",
              "ambiguous_date",
              "doubleheader",
              "postponed",
              "rescheduled",
              "multi_turn_correction",
              "unsupported_premise"
            ]
          },
          "route": {
            "enum": [
              "platform",
              "account",
              "educational",
              "matchup",
              "full_slate",
              "historical",
              "live_data",
              "bet_explanation",
              "general_sports"
            ]
          },
          "severity": {
            "enum": ["high", "critical"]
          },
          "asOfUtc": {
            "type": "string",
            "format": "date-time"
          },
          "promptTurns": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["role", "content"],
              "properties": {
                "role": {
                  "enum": ["user", "assistant"]
                },
                "content": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "evidenceFixtures": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["sourceId", "observedAt", "status", "data"],
              "properties": {
                "sourceId": {
                  "type": "string",
                  "minLength": 1
                },
                "observedAt": {
                  "type": "string",
                  "format": "date-time"
                },
                "status": {
                  "enum": ["ok", "partial", "not_found", "conflict", "error"]
                },
                "data": {
                  "type": "object"
                }
              }
            }
          },
          "requiredBehaviors": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "forbiddenClaims": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "mandatoryTools": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "outputSchemaRequired": {
            "type": "boolean"
          },
          "identityIsolationRequired": {
            "type": "boolean"
          },
          "scoringDimensions": {
            "type": "array",
            "minItems": 4,
            "uniqueItems": true,
            "items": {
              "enum": [
                "correctness",
                "groundedness",
                "unsupported_claims",
                "instruction_adherence",
                "tool_selection",
                "schema_compliance",
                "completeness",
                "calibration"
              ]
            }
          }
        }
      }
    }
  }
}
