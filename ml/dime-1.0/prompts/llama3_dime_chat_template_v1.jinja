{{- bos_token }}
{%- for message in messages %}
{{- '<|start_header_id|>' + message['role'] + '<|end_header_id|>\n\n' }}
{%- if message['role'] == 'assistant' %}
{%- generation %}
{{- message.get('content', '') }}
{%- if message.get('tool_calls') %}
{%- for tool_call in message['tool_calls'] %}
{{- '\n<tool_call>' + (tool_call | tojson) + '</tool_call>' }}
{%- endfor %}
{%- endif %}
{{- '<|eot_id|>' }}
{%- endgeneration %}
{%- elif message['role'] == 'tool' %}
{{- '<tool_result>' }}
{{- dict(tool_call_id=message.get('tool_call_id', ''), name=message.get('name', ''), content=message.get('content', '')) | tojson }}
{{- '</tool_result><|eot_id|>' }}
{%- else %}
{{- message.get('content', '') + '<|eot_id|>' }}
{%- endif %}
{%- endfor %}
{%- if add_generation_prompt %}
{{- '<|start_header_id|>assistant<|end_header_id|>\n\n' }}
{%- endif %}
